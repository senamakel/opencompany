# Rust build artifacts
target/
# Tauri's generated permission/ACL schemas. Regenerated by every build, so a
# committed copy is churn that conflicts on every branch. The
# `frontend/src-tauri/` path is kept because older branches still write there;
# that app is gone from this one.
crates/opencompany-app/gen/
frontend/src-tauri/gen/
*.profraw
*.profdata
lcov.info

# Local configuration
.env
.env.*
!.env.example

# Editor and OS noise
.DS_Store
.idea/
.vscode/

# Node cache written when a tool runs from the repo root. `frontend/.gitignore`
# already covers the real install in `frontend/node_modules/`.
node_modules/

# agent worktrees (isolation)
.claude/worktrees/

# Local worktree files
worktrees/*
!worktrees/.gitkeep

# `.cargo/config.toml` is TRACKED as of issue #895: it carries the
# `RUST_MIN_STACK` floor the gated test suite needs, so a local run and CI agree
# by construction instead of by tribal knowledge. It used to be ignored so a
# developer could drop in a cargo path-override pointing at a sibling openhuman
# checkout; that override now belongs in `$CARGO_HOME/config.toml` or a
# PARENT-directory `.cargo/config.toml`, both of which Cargo merges with this
# one automatically — the same arrangement the openhuman repo documents in its
# own `.cargo/config.toml`. Keeping it ignored would mean the stack floor could
# never ship, which is the whole point of the change.

# Instance runtime state, written into the data root — which is the repo root
# when a `serve` runs with neither OPENCOMPANY_DATA_DIR nor HOME set. A
# committed `instance-id` would hand every clone the same public identity,
# which is the one thing that file exists not to do.
instance-id
.lock
/target

# Playwright MCP scratch output when a client ignores `--output-dir`.
.playwright-mcp/

# Playwright's per-run tracking file when a run happens with the repo root as
# cwd (its default `outputDir` resolves relative to the run's cwd, not the
# config). CI and normal runs write `frontend/test-results/`, which
# `frontend/.gitignore` already covers; this catches the root-level copy.
test-results/

# Python bytecode from the headless drivers in `scripts/` (e.g.
# `scripts/hive-euler.py`). CPython writes these beside the script whenever one
# is imported rather than run, and the tag is interpreter-specific, so a
# committed copy is both noise and wrong for the next reader's Python.
__pycache__/
*.pyc

# A local `serve` data root inside the checkout. `OPENCOMPANY_DATA_DIR` is the
# only knob that isolates two local `serve` processes from each other
# (`docs/spec/runtime/storage.md`), so pointing it at a directory beside the
# source is the ordinary way to run a second instance — and everything the
# instance then writes is runtime state: the event log, the agent journal, the
# derived ledgers, and `secrets/`, which holds the inference key in the clear.
# None of it is source, and the last of it must never reach a remote.
.local-data/
